{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v2.json",
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.117.2",
    "@negrel/webpush": "jsr:@negrel/webpush@0.5.0"
  },
  "tasks": {
    "check": "deno check index.ts",
    "lint": "deno lint index.ts",
    "fmt": "deno fmt --check index.ts deno.json"
